$void: $background;
$raised: $panel;
$cyan: $primary;
$magenta: $secondary;
$green: $success;
$amber: $warning;
$red: $error;

Screen { background: $void; color: $foreground; }

#top-rail {
    height: 2; padding: 0 2; background: $surface; color: $cyan;
    border-bottom: solid $primary-muted;
}
#deck-brand { width: auto; height: 1; color: $cyan; text-style: $deck-heading-style; }
#uplink-count { width: auto; height: 1; margin-left: 8; color: $cyan; text-style: $deck-heading-style; }
#deck-clock { width: 1fr; height: 1; color: $cyan; text-style: $deck-heading-style; content-align: right top; }
#workspace { height: 1fr; }
#sidebar { width: 34; min-width: 26; background: $background; border-right: solid $surface-lighten-2; }
#sidebar-title { width: 100%; height: 3; padding: 1 0; color: $cyan; text-style: $deck-heading-style; content-align: center middle; }
#agents { height: 2fr; background: transparent; }
#agents > ListItem { height: 4; padding: 0 2; color: $muted; }
#agents > ListItem.--highlight { background: $surface; color: $cyan; border-left: thick $cyan; }
#modules-title { width: 100%; height: 2; color: $cyan; text-style: $deck-heading-style; content-align: center middle; border-top: solid $surface-lighten-2; }
#modules { height: 1fr; min-height: 6; max-height: 16; background: transparent; }
#modules > ListItem { height: 3; padding: 0 2; color: $muted; }
#modules > ListItem.--highlight { background: $panel; color: $cyan; border-left: thick $magenta; }
#spawn-hint { height: 3; padding: 0 2; color: $muted; border-top: solid $surface-lighten-2; content-align: left middle; }

#main-panel { width: 1fr; min-width: 0; background: $void; }
.deck-module { width: 100%; height: 1fr; }
#agent-header {
    height: 4; padding: 1 2 0 2; background: $surface; color: $cyan;
    border-bottom: solid $secondary-muted;
}
#agent-primary { width: 100%; height: 1; }
#signal-trace { width: 100%; height: 1; color: #1a8793; }
#agent-name, #agent-state { width: auto; height: 1; color: $cyan; text-style: bold; }
#agent-state, #agent-model, #agent-activity { width: auto; height: 1; margin-left: 3; color: $cyan; }
#agent-network { width: auto; height: 1; margin-left: 3; color: $green; text-style: bold; }
#agent-mnem { width: auto; height: 1; margin-left: 3; color: $green; text-style: bold; }
#agent-cwd { width: 1fr; height: 1; margin-left: 3; color: $cyan; content-align: right top; }
#state-transition {
    height: 1; margin: 0 1; padding: 0 1; background: $surface;
    color: $cyan; border-left: thick $magenta;
}
#conversation { height: 1fr; margin: 0 1; padding: 1 1; border: solid $panel-lighten-1; scrollbar-color: $magenta; scrollbar-background: $surface; }
TerminalMessage { width: 100%; height: auto; min-height: 1; margin-bottom: 0; color: $foreground; }
EmptyGrid { width: 100%; height: 1fr; padding: 4 6; content-align: center middle; }
.load-older { height: 2; color: $cyan; text-style: bold; content-align: center middle; }

#operations-console { height: 11; background: $surface; border-top: solid $primary-muted; }
#operations-title { height: 2; padding: 0 2; color: $cyan; text-style: bold; content-align: left middle; }
#operations-list { height: 1fr; background: transparent; }
#operations-list > ListItem { height: 1; padding: 0 2; color: #708396; }
#operations-list > ListItem.--highlight { background: $primary-muted; color: $foreground; }

#autocomplete {
    display: none;
    height: auto;
    max-height: 7;
    padding: 0 2;
    background: $surface;
    border-top: solid $primary-muted;
    color: $muted;
}
#prompt-zone { height: 5; padding: 0 1; background: $background; }
#prompt-label { height: 1; color: $cyan; text-style: bold; }
#prompt-bar { height: 3; padding: 0 1; background: $surface; border: tall $cyan; }
#prompt-prefix { width: auto; height: 1; color: $cyan; text-style: bold; content-align: left top; }
#prompt { width: 1fr; height: 1; border: none; background: transparent; padding: 0 1; content-align: left top; }
#prompt:focus { border: none; }
#shortcut-rail { height: 2; padding: 0 2; background: $surface; color: $muted; content-align: right middle; }

#journal-header { height: 4; padding: 1 2; background: $surface; border-bottom: solid $magenta; }
#journal-title { width: auto; color: $cyan; text-style: $deck-heading-style; }
#journal-status { width: 1fr; color: $muted; content-align: right top; }
#journal-body { height: 1fr; margin: 0 1; border: solid $panel-lighten-1; }
#journal-index { width: 30; min-width: 22; background: $background; border-right: solid $surface-lighten-2; }
#journal-search { height: 3; border: tall $primary-muted; background: $surface; }
#journal-search:focus { border: tall $cyan; }
#journal-days { height: 1fr; background: transparent; }
#journal-days > ListItem { height: 3; padding: 0 1; color: $muted; }
#journal-days > ListItem.--highlight { background: $primary-muted; color: $cyan; border-left: thick $magenta; }
#journal-document { width: 1fr; min-width: 0; }
#journal-date { height: 2; padding: 0 2; color: $cyan; text-style: bold; border-bottom: solid $primary-muted; }
#journal-editor { height: 1fr; border: none; background: $void; color: $foreground; }
#journal-editor:focus { border: none; }
#journal-help { height: 2; padding: 0 2; color: $muted; content-align: right middle; }

BootScreen {
    layout: vertical;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: #02050a;
}
#boot-log {
    width: 100%;
    height: 1fr;
    margin: 0;
    padding: 0 2;
    background: #02050a;
    overflow: hidden hidden;
}
#boot-skip {
    dock: bottom;
    width: 100%; height: 2; margin: 0; padding: 0 1; color: $muted; background: #02050a;
    border-top: solid #153244; content-align: right middle;
}

SpawnAgent, HelpScreen, AboutScreen, RestoreScreen, OperationDetail, ConfirmScreen, OperativeControl, AgentSwitcher, DispatchScreen, ThemeScreen { align: center middle; background: rgba(0, 0, 8, 0.88); }
#spawn-dialog, #help-dialog, #restore-dialog {
    width: 76; max-width: 94%; padding: 1 2; background: $surface; border: tall $cyan;
}
#spawn-dialog { height: 15; }
#spawn-agent-name, #spawn-agent-path {
    width: 100%; height: 3; margin-top: 1; border: tall #1a4052; background: #071019;
}
#spawn-agent-name:focus, #spawn-agent-path:focus { border: tall $cyan; }
#help-dialog { height: 32; }
#restore-dialog { width: 100; height: 80%; border: double $magenta; }
#spawn-title, #help-title, #restore-title { height: 3; color: $cyan; text-style: bold; content-align: center middle; border-bottom: solid #153244; }
#help-content { height: 1fr; padding: 1; }
#restore-search, #restore-name { height: 3; margin-top: 1; border: tall #1a4052; background: #071019; }
#restore-list { height: 1fr; margin: 1 0; background: #050a10; }
#restore-list > ListItem { height: 3; padding: 0 1; color: $muted; }
#restore-list > ListItem.--highlight { background: #102832; color: $cyan; border-left: thick $magenta; }
#restore-help, .modal-help { height: 2; color: $muted; content-align: center middle; }
.approval-message { width: 78; max-width: 94%; height: auto; margin: 1 0 1 10; background: #09070d; }
.approval-message:focus { background: #160710; }
#operation-detail { width: 90%; height: 85%; padding: 2 3; background: #050b14; border: tall $cyan; }
#confirm-dialog, #control-dialog, #switch-dialog, #dispatch-dialog {
    width: 78; max-width: 94%; padding: 1 2; background: $surface; border: tall $cyan;
}
#theme-dialog { width: 78; max-width: 94%; height: 65%; padding: 1 2; background: $surface; border: double $magenta; }
#theme-title { height: 3; color: $cyan; text-style: bold; content-align: center middle; border-bottom: solid #153244; }
#theme-list { height: 1fr; margin: 1 0; background: #050a10; }
#theme-list > ListItem { height: 3; padding: 0 1; color: $muted; }
#theme-list > ListItem.--highlight { background: #102832; color: $cyan; border-left: thick $magenta; }
#about-dialog { width: 76; max-width: 94%; height: 34; padding: 1 2; background: $surface; border: double $cyan; }
#about-title { height: 3; color: $cyan; text-style: $deck-heading-style; content-align: center middle; border-bottom: solid $primary-muted; }
#about-content { height: 1fr; padding: 1 2; color: $foreground; }
#confirm-dialog { height: 12; border: double $red; }
#control-dialog { height: 27; }
#switch-dialog { width: 96; height: 70%; border: double $magenta; }
#dispatch-dialog { width: 96; height: 80%; border: double $magenta; }
#confirm-title, #control-title, #switch-title, #dispatch-title {
    height: 3; color: $cyan; text-style: bold; content-align: center middle; border-bottom: solid #153244;
}
#confirm-message { height: 1fr; padding: 1; content-align: center middle; }
#control-name, #switch-search, #dispatch-search, #dispatch-prompt { height: 3; margin-top: 1; border: tall #1a4052; background: #071019; }
#control-list, #switch-list, #dispatch-list { height: 1fr; margin: 1 0; background: #050a10; }
#control-list > ListItem { height: 2; padding: 0 1; }
#switch-list > ListItem { height: 3; padding: 0 1; }
#dispatch-list > ListItem { height: 2; padding: 0 1; }
#control-list > ListItem.--highlight, #switch-list > ListItem.--highlight, #dispatch-list > ListItem.--highlight { background: #102832; color: $cyan; border-left: thick $magenta; }
#dispatch-help { height: 2; color: $muted; content-align: center middle; }
